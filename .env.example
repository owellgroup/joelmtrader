# ================================================================
#  Copy this file to ".env" and edit. Never commit ".env".
#  The DB / SMTP values below are YOUR DEMO values - rotate them before going live.
# ================================================================

# ---- Database (PostgreSQL) -------------------------------------
DB_URL=jdbc:postgresql://84.8.131.140:5432/forex?prepareThreshold=0
DB_USERNAME=joelchipoya
DB_PASSWORD=Kalimbwejoel

# ---- E-mail (Resend SMTP) --------------------------------------
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_38aPTU28_xc6kxtfaaGfBkSvGF8uJaQoi
MAIL_FROM=hello@notifications.wayaspot.com
# Who receives reports (comma separated)
REPORT_TO=joel@wayaspot.com
# PUBLIC https URL of your logo (PNG, ~300px wide, hosted anywhere). Used in the e-mail header.
LOGO_URL=
BRAND_NAME=WayaSpot FX Bot
# Daily digest time (Spring cron, UTC). Default 23:55 UTC
DAILY_REPORT_CRON=0 55 23 * * *

# ---- Super admin (created automatically on first start) --------
ADMIN_USERNAME=joel@wayaspot.com
ADMIN_PASSWORD=Kalimbwejoel@01

# ---- Security secrets: CHANGE THESE to long random strings ------
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRY_DAYS=365
APP_ENCRYPTION_KEY=change-this-encryption-key
ENGINE_API_KEY=change-me-engine-key
INTERNAL_API_KEY=change-me-internal-key

# ---- Trading engine --------------------------------------------
# paper = built-in simulator (no broker needed - use it to test everything)
# mt5   = real/demo MetaTrader 5 account (the Docker stack includes the MT5 desktop)
BROKER_MODE=mt5
PAPER_BALANCE=12
PAPER_SPEED=1
# Broker symbol suffix if your broker uses one (e.g. "m" -> EURUSDm, ".a" -> EURUSD.a). Leave empty to auto-detect.
SYMBOL_SUFFIX=
MAGIC_NUMBER=26101801
# Optional MT5 auto-login (you can also link the account from the app's Settings page)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Windows only: full path to terminal64.exe if MT5 is installed in a non-default place
MT5_PATH=
# Linux / Docker only: host & port of the Wine MT5 container (rpyc)
MT5_RPYC_HOST=mt5
MT5_RPYC_PORT=8001

# ---- MT5 desktop container (started automatically by docker compose) -----
MT5_VNC_USER=admin
MT5_VNC_PASSWORD=change-me-vnc

# Public URL of the Java API. Baked into the Flutter web image at build time.
# Use the address phones and browsers can reach (not http://engine or localhost).
PUBLIC_API_URL=http://84.8.131.140:8080
WEB_PORT=80

# ---- Advanced: engine on ANOTHER machine (e.g. a Windows VPS running MT5). Leave empty normally.
# ENGINE_URL_OVERRIDE=http://WINDOWS_VPS_IP:8000
